# Server
PORT=4000
NODE_ENV=development
CORS_WHITELIST=http://localhost:3000

# Auth (issue JWTs for your API)
JWT_SECRET=

# Firebase Admin — paste full service account JSON (Vercel-friendly)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: legacy split fields instead of FIREBASE_SERVICE_ACCOUNT_JSON
# FIREBASE_SERVICE_ACCOUNT_TYPE=service_account
# FIREBASE_SERVICE_ACCOUNT_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
# FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=
# FIREBASE_SERVICE_ACCOUNT_CLIENT_ID=
# FIREBASE_SERVICE_ACCOUNT_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FIREBASE_SERVICE_ACCOUNT_TOKEN_URI=https://oauth2.googleapis.com/token
# FIREBASE_SERVICE_ACCOUNT_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# FIREBASE_SERVICE_ACCOUNT_CLIENT_X509_CERT_URL=
# FIREBASE_SERVICE_ACCOUNT_UNIVERSE_DOMAIN=googleapis.com

# Firebase Web API key (Identity Toolkit sign-in on the server; same as client Firebase config)
FIREBASE_WEB_API_KEY=

# Optional: only if you use Realtime Database
# FIREBASE_DATABASE_URL=

# Ably
ABLY_API_KEY=

# Redis (JWT blacklist, etc.)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Vercel Cron: set in Vercel project env; Vercel sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Local only: set to "true" to run node-cron in-process (not used on Vercel)
ENABLE_NODE_CRON=false

# ComplyCube (KYC)
COMPLYCUBE_API_KEY=
COMPLYCUBE_WEBHOOK_SECRET=
